# Doxyfile for Magno Project
PROJECT_NAME           = "Magno Backend"
PROJECT_NUMBER         = "1.0.0"
OUTPUT_DIRECTORY       = ../docs/backend
CREATE_SUBDIRS         = YES
OUTPUT_LANGUAGE        = English
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = README.md

# Input files
INPUT                  = src/main/java README.md
RECURSIVE              = YES
FILE_PATTERNS          = *.java *.md

# Java specific
OPTIMIZE_OUTPUT_JAVA   = YES
JAVADOC_AUTOBRIEF      = YES

# Extraction settings
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES

# Graphics (Requires Graphviz installed for best results)
HAVE_DOT               = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
DIRECTORY_GRAPH        = YES
GRAPHICAL_HIERARCHY    = YES

# HTML output
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_DYNAMIC_SECTIONS  = YES

# Disable Latex/others if not needed
GENERATE_LATEX        = NO
GENERATE_MAN          = NO
GENERATE_RTF          = NO
